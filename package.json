{
  "name": "@wuren2/dsh-liquid-glass",
  "version": "2.2.2",
  "description": "Liquid_Glass brings edge refraction and glass controls to DeepSeek Harness.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4964368/dsh-liquid-glass.git"
  },
  "homepage": "https://github.com/4964368/dsh-liquid-glass#readme",
  "bugs": {
    "url": "https://github.com/4964368/dsh-liquid-glass/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "liquid-glass",
    "plugin"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "styles.css",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
